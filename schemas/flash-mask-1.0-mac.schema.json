{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://flashmask.net/schema/flash-mask-1.0-mac.schema.json",
  "title": "Flash Mask 1.0 Mac producer profile",
  "allOf": [
    { "$ref": "flash-mask-1.0.schema.json" },
    {
      "type": "object",
      "properties": {
        "source_image": {
          "allOf": [
            { "$ref": "flash-mask-1.0.schema.json#/$defs/sourceImage" },
            { "type": "object", "required": ["file_path"] }
          ]
        }
      }
    }
  ]
}
